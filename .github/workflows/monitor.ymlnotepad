name: Ralph Lauren Vinted Monitor

on:
  schedule:
    - cron: "*/10 * * * *"

  workflow_dispatch:

permissions:
  contents: write

jobs:
  monitor:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install playwright resend
          python -m playwright install --with-deps chromium

      - name: Run Vinted monitor
        env:
          RESEND_API_KEY: ${{ secrets.RESEND_API_KEY }}
        run: |
          python ralph_lauren_monitor.py

      - name: Save seen listings
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add seen_listings.json

          if git diff --cached --quiet; then
            echo "No changes to seen listings."
          else
            git commit -m "Update seen listings"
            git push
          fi